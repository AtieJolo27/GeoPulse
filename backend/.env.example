SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# The id of the farm whose zones this single-farm app manages.
# Run: select id, name from farms;  in Supabase to find this value.
DEFAULT_FARM_ID=1

# Google requests execute here in Render's Oregon region.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
# Use the same random server-only value in EAS Hosting.
GEMINI_PROXY_TOKEN=replace-with-a-long-random-token
