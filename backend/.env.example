SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# The id of the farm whose zones this single-farm app manages.
# Run: select id, name from farms;  in Supabase to find this value.
DEFAULT_FARM_ID=1

# Hosted backend only; never bundle this secret into the APK.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
